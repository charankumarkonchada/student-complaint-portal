# ==============================================================================
# IntelliHostel — Environment Configuration Template
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file containing real secrets to Git.
# ==============================================================================

# Flask Core Configuration
SECRET_KEY=replace-with-a-random-secret-key-32-chars
FLASK_DEBUG=1
APP_BASE_URL=http://127.0.0.1:5000

# Campus Branding
COLLEGE_NAME=RGUKT Ongole
COLLEGE_DOMAIN=@rguktong.ac.in

# Database Configuration (Leave DATABASE_URL blank to fall back to local SQLite)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.pooler.supabase.com:6543/postgres
DB_SSLMODE=require

# Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Email Service Configuration (Google App Password recommended for SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-college-or-personal-email@gmail.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=your-college-or-personal-email@gmail.com
SMTP_USE_TLS=1

# Cloud Storage Configuration (Supabase Storage Bucket)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=complaint-attachments

# Password Reset OTP Policies
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
