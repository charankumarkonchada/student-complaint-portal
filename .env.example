# =============================================================================
# IntelliHostel Student Complaint Portal - Environment Configuration Template
# Copy this file to '.env' and fill in the values appropriate for your environment.
# DO NOT commit the actual '.env' file containing secrets to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Core Application Security
# -----------------------------------------------------------------------------
# Generate a strong 64-character hex secret: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-very-long-random-secret-key-in-production

# Set to 0 in production; set to 1 only during local development
FLASK_DEBUG=0

# Server port (defaults to 5000 if unset)
PORT=5000

# Base URL used for generating absolute links in emails (e.g., password reset links)
APP_BASE_URL=https://complaints.yourcollege.edu

# Session security (1=True, 0=False; defaults to secure when FLASK_DEBUG=0)
SESSION_COOKIE_SECURE=1

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string (e.g. Supabase connection pooler, Neon, AWS RDS, Railway)
# Example: postgresql://postgres.xxxx:your_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# If left empty, IntelliHostel automatically falls back to local SQLite (database.db)
DATABASE_URL=

# SSL mode for PostgreSQL connection (require, prefer, disable)
DB_SSLMODE=require

# -----------------------------------------------------------------------------
# College Identity & Access Bounds
# -----------------------------------------------------------------------------
COLLEGE_NAME=Rajiv Gandhi University of Knowledge Technologies - Ongole
COLLEGE_DOMAIN=@rguktong.ac.in

# Master Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-a-strong-admin-password-here

# -----------------------------------------------------------------------------
# SMTP Email Delivery (Gmail / SendGrid / AWS SES)
# -----------------------------------------------------------------------------
# Required for password reset OTP delivery and system broadcast notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-hostel-portal-email@gmail.com
# For Gmail, generate a 16-character "App Password" under Google Account -> Security
SMTP_PASSWORD=your-app-password-here
MAIL_FROM="IntelliHostel Portal <your-hostel-portal-email@gmail.com>"
SMTP_USE_TLS=1
EMAIL_NOTIFICATIONS_ENABLED=1

# OTP Security Parameters
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Cloud Attachment Storage (Supabase Storage)
# -----------------------------------------------------------------------------
# Optional: if omitted, complaint attachments are saved locally in static/uploads/
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=complaint-attachments

# -----------------------------------------------------------------------------
# Production Web Server (Gunicorn) Settings
# -----------------------------------------------------------------------------
# Recommended worker count: 2 to 4 workers for standard college workloads
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
LOG_LEVEL=info
